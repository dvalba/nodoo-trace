# APPLICATION
NODE_ENV=development
PORT=3001
PLATFORM_NAME=NodooTrace
HOST_FRONT=http://localhost:4200

# DATABASE
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=supply_chain_db

# JWT
JWT_SECRET=change-me-use-at-least-32-characters
JWT_EXPIRES_IN=2h

# INVITATIONS
TOKEN_SECRET=change-me-use-at-least-32-characters
INVITATION_RESEND_INTERVAL=5m
INVITATION_EXPIRES_IN=7d

# EMAIL
# Proveedor: "file" (escribe a MAIL_OUTBOX_PATH, default) o "smtp".
EMAIL_PROVIDER=file
# Opcionales con "file":
MAIL_OUTBOX_PATH=./.mail-outbox.json
# Obligatorios con "smtp" (SMTP_PORT default 587, SMTP_SECURE default false):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Remitente (default: NodooTrace <no-reply@nodoo.local>):
# SMTP_FROM=NodooTrace <no-reply@nodoo.local>

# STAFF SEED
STAFF_EMAIL=staff@nodoo.local
STAFF_PASSWORD=ChangeMe123
STAFF_FULL_NAME=Platform Staff
